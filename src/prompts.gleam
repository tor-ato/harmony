//// Prompts for the locate / transcribe / analyze passes.

import gleam/int
import gleam/list
import gleam/string

pub fn transcribe_prompt(
  page: Int,
  number: String,
  label: String,
  index: Int,
  total: Int,
) -> String {
  let image = case total {
    1 ->
      "印刷楽譜の "
      <> int.to_string(page)
      <> " ページ目から切り出した高解像度クロップ（"
      <> label
      <> "）"
    _ ->
      "印刷楽譜の "
      <> int.to_string(page)
      <> " ページ目にある "
      <> int.to_string(total)
      <> " 段のうち "
      <> int.to_string(index)
      <> " 段目だけを、左端から右端まで切り出した高解像度クロップ（"
      <> label
      <> "）"
  }

  "あなたはプロの音楽理論家兼アーキビストです。添付画像は"
  <> image
  <> "です。対象は No."
  <> number
  <> " だけです。同じページの他の番号の曲は無視してください。

画像は鮮明な部分拡大で、1枚に1段ぶんがすべて入っています。読める音は「不明」と書かず、音名を確定してください。画像の粗さ・解像度への言及は不要です。小節は左から順に数え、ラベルに「小節X-Y」が含まれる場合はその番号を全体の小節番号として使ってください。画像の端で切れている小節だけ「切れ」と書き、見えない部分を推測で補わないでください。

出力は次のJSONのみとしてください。コードフェンスや前後の説明文は禁止です。

{
  \"key\": \"調性（例: ヘ長調 / F major。見えない場合は空文字）\",
  \"meter\": \"拍子（例: 3/4。見えない場合は空文字）\",
  \"bars\": [
    {
      \"bar\": \"小節番号（全体番号。例: 1）\",
      \"beat\": \"拍（例: 1、2、3）\",
      \"chord\": \"和音（例: G7/D、F/C。不明なら「不明」）\",
      \"notes\": \"構成音（例: D-G-B♮-F）\",
      \"comment\": \"短い補足（任意）\"
    }
  ],
  \"melody\": \"旋律・動機の短い説明\",
  \"rhythm\": \"伴奏・リズム・装飾音の短い説明\",
  \"uncertain\": [\"本当に読めない箇所だけ\"]
}

ルール:
- bars はこの画像で読める小節だけ。全体の小節番号を使う。
- 読めた音を uncertain に入れない。不明な音だけ uncertain に書く。
- 説明は簡潔に。同じ注意書きを繰り返さない。"
}

pub fn analyze_prompt(number: String, text: String) -> String {
  "あなたはプロの音楽理論家です。以下は印刷楽譜の No."
  <> number
  <> " を高解像度で書き起こしたものです。以下は各クロップのJSON書き起こしを含みます。重複する小節を統合し、全体の小節番号で表を作り、曲全体の和声分析を日本語で行ってください。

"
  <> string.trim(text)
  <> "

出力は次の形式のJSONオブジェクトのみとしてください。コードフェンス（```）や前後の説明文は禁止です。

{
  \"meta\": {
    \"key\": \"主調（例: ヘ長調 / F major）\",
    \"meter\": \"拍子（例: 3/4）\",
    \"form\": \"形式（例: A(1-8) B(9-16) A'(17-24)）\",
    \"confidence\": \"high | medium | low\",
    \"mock\": false
  },
  \"table\": [
    {
      \"bar\": \"通し小節番号（例: 1）\",
      \"beat\": \"拍（例: 1、1-3、4）\",
      \"chord\": \"和音（例: F、C/E、B♭）\",
      \"function\": \"機能（T / SD / D / Tp など。日本語でも可）\",
      \"notes\": \"構成音や転回・非和声音のメモ\",
      \"comment\": \"短い補足\"
    }
  ],
  \"prose\": \"日本語の分析文\"
}

ルール:
- table は主要な和音変化のある小節・拍に絞る。全拍を機械的に埋めない。
- 記述にない小節を捏造しない。不明な箇所は chord を「不明」とし、prose でも不明と書く。
- 反復記号がある場合は、形式の説明に演奏順（例: A A B A' A'）を明記するが、table は譜面上の小節番号で一度だけ書く。
- prose は800〜1500字程度。調性、拍子、形式と反復、テクスチュア、旋律・動機、主要な和声進行、転調・借用和音（♭VIなど）、注目すべき箇所、演奏への示唆、様式的位置づけを含める。段落は改行で区切る。
- 過度に断定的な演奏解釈は避け、譜面から言えることと推測を区別する。"
}

pub fn locate_prompt(targets: List(String), system_count: Int) -> String {
  let target_list =
    targets
    |> list.map(fn(number) { "No." <> number })
    |> string.join("、")

  "画像は印刷楽譜の1ページ全体です。各段には上から順に 1〜"
  <> int.to_string(system_count)
  <> " の番号を振ってあります。

次の曲番号が、それぞれどの段に含まれるかを判定してください: "
  <> target_list
  <> "

出力は次のJSONのみとしてください。コードフェンスや説明文は禁止です。

{\"found\":[{\"number\":\"32\",\"systems\":[2,3],\"bars\":[8,8]}],\"missing\":[\"34\"]}

ルール:
- 曲番号は譜面に印刷された「No.32」などの表記を探す。見つからなければ missing に入れる。
- systems は画像に振られた段番号（1始まり）を昇順で入れる。
- bars は systems と同じ順番で、各段の小節数を入れる。小節線を数えて推定する。不明なら 0 を入れる。
- 曲が段の途中で始まる／終わる場合も、その段を含める。
- 対象として指定された番号だけを返す。関係ない曲番号は返さない。
- 同じ番号が複数の段にまたがる場合は、すべての段番号を入れる。
- 判定に自信がない場合も、見えている表記を優先してできるだけ返す。"
}
